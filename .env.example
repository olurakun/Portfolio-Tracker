# Supabase (zorunlu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Akıllı içe aktarma (opsiyonel).
# Kullanıcılar zaten kendi anahtarlarını arayüzden girebiliyor (tarayıcıda
# saklanır, sunucuya kaydedilmez). Buradaki anahtar yalnızca YEDEKTİR ve
# kendi anahtarı olmayan HER oturum açmış kullanıcı tarafından kullanılır —
# yani faturası sana gelir. Çok kullanıcılı/ticari dağıtımda BOŞ BIRAK.
# Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Twelve Data (opsiyonel, Faz 7).
# Gün sonu fiyat verisi için. Ücretsiz katmanda da çalışır.
# Anahtar: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

# CoinGecko (kripto fiyatları, opsiyonel).
# Ücretsiz Demo plan: kredi kartı gerekmez, 100 istek/dk, 10.000/ay.
# Anahtar: https://www.coingecko.com/en/developers/dashboard -> "New API Key"
COINGECKO_API_KEY=
