# Supabase (zorunlu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Akıllı içe aktarma (opsiyonel).
# Kullanıcılar zaten kendi anahtarlarını arayüzden girebiliyor (tarayıcıda
# saklanır, sunucuya kaydedilmez). Buradaki anahtar yalnızca YEDEKTİR ve
# kendi anahtarı olmayan HER oturum açmış kullanıcı tarafından kullanılır —
# yani faturası sana gelir. Çok kullanıcılı/ticari dağıtımda BOŞ BIRAK.
# Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Twelve Data (Faz 7 — hisse ve maden fiyatları).
# Anahtar: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
# Anahtarın varlığı TEK BAŞINA yetmez; geçiş bu bayrakla açılır. Ücretsiz
# Basic katmanının kotasını kazara harcamamak için bilinçli bir onay adımı.
# Ticari kullanım Venture planı gerektirir ($149, "External display data
# access" — son kullanıcıya gösterim serbest, ham veri/API dağıtımı değil).
TWELVE_DATA_ENABLED=false

# CoinGecko (kripto fiyatları, opsiyonel).
# Ücretsiz Demo plan: kredi kartı gerekmez, 100 istek/dk, 10.000/ay.
# Anahtar: https://www.coingecko.com/en/developers/dashboard -> "New API Key"
COINGECKO_API_KEY=

# Paylaşılan fiyat deposu (app/api/cron/refresh-prices).
# SERVICE ROLE anahtarı RLS'i atlar — sadece sunucuda kullanılır, ASLA
# NEXT_PUBLIC_ öneki verme. Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Toplu yenileme ucunu koruyan sır. Tanımlı değilse uç tamamen kapalıdır.
# Üret: openssl rand -hex 32
CRON_SECRET=
